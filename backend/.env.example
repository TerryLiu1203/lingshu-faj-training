# 灵枢智训后端 - 环境变量配置示例
# 复制本文件为 .env 并填入你的 Kimi API Key

# Kimi API Key（必填，从 https://platform.moonshot.cn 控制台获取）
KIMI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# Kimi 模型（请填写你的账号实际可用模型；不填时代码默认 kimi-k2.6）
KIMI_MODEL=kimi-k2.6

# Kimi API 端点（默认国内端点）
KIMI_BASE_URL=https://api.moonshot.cn/v1

# 服务端口（默认 3000）
PORT=3000

# 单个IP每分钟允许的聊天/评分请求数
RATE_LIMIT_PER_MINUTE=10
